# ========================================
# Uptime Monitor — Environment Configuration
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uptimemonitor
POSTGRES_USER=uptimemonitor
POSTGRES_PASSWORD=uptimemonitor

# ----- Google OAuth 2.0 -----
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----- Application URLs -----
API_SERVICE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ----- Email / SMTP (Gmail SMTP) -----
# For Gmail: Use your Gmail address and a 16-character Google App Password
# (Generate at: https://myaccount.google.com/apppasswords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# ----- Next.js Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:3000
